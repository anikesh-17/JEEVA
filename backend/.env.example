# MongoDB connection string. Replace <user>, <pass>, <cluster>, and <database>.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/jeeva?retryWrites=true&w=majority

# Firebase Admin service account JSON encoded as a single line.
# Example: FIREBASE_SERVICE_ACCOUNT='{ "type": "service_account", ... }'
FIREBASE_SERVICE_ACCOUNT={}

# Backend port
PORT=4000

# Blockchain Configuration
BLOCKCHAIN_NETWORK=ethereum
BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/your-infura-key
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

